{
  "name": "heldiglab-site-css",
  "private": true,
  "scripts": {
    "build": "npm run build:home && npm run build:app && npm run build:base",
    "build:home": "tailwindcss -c home.config.js -i input.css -o ../assets/css/home.css --minify",
    "build:app": "tailwindcss -c app.config.js -i input.css -o ../assets/css/app.css --minify",
    "build:base": "tailwindcss -c base.config.js -i input.css -o ../assets/css/base.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.10",
    "tailwindcss": "3.4.17"
  }
}
